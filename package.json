{
  "name": "totem-app",
  "version": "0.0.1",
  "description": "Totembound is a blockchain-based NFT game where players raise, train, and evolve mystical owl companions. Players connect to their totemic spirit animals, unlocking wisdom, rewards, and governance roles in an immersive journey of growth and discovery.",
  "private": true,
  "dependencies": {
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "@marsidev/react-turnstile": "1.1.0",
    "ethers": "^6.14.4",
    "http-proxy-middleware": "^3.0.5",
    "lucide-react": "^0.474.0",
    "posthog-js": "^1.239.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.20.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.3.6",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-textshadow": "^2.1.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "check-types": "tsc --noEmit",
    "analyze": "vite build --mode analyze",
    "serve": "vite preview --port 3000"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totembound/totem-app.git"
  },
  "author": "TotemBound",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/totembound/totem-app/issues"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.10.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^5.11.1",
    "lodash": "^4.17.21",
    "postcss": "^8.4.41",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^4.9.5",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
