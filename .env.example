# TotemBound Frontend Environment Variables
# Copy to .env.local for local development

# API endpoint (local dev server)
VITE_API_URL=http://localhost:3001/v1

# App version
VITE_VERSION=0.0.1

# PostHog analytics (optional)
VITE_PUBLIC_POSTHOG_KEY=your_posthog_key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_AUTOCAPTURE=false

# Cloudflare Turnstile captcha (optional for local)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# OAuth social login (optional — buttons hidden if unset)
VITE_GOOGLE_CLIENT_ID=
VITE_TWITCH_CLIENT_ID=
